{
  "info": {
    "name": "MediFlow - Mail-Order Pharmacy",
    "description": "End-to-end API collection for the MediFlow microservices (auth, drugs, subscriptions, refill).\n\nUsage:\n1. Run **Auth > Sign In** first — its test script stores `token` and `memberId` as collection variables, which every other request reuses via `Authorization: Bearer {{token}}`.\n2. Base URLs default to the local dev ports (8081-8084). Override the `*_url` variables for a deployed environment.\n\nAll example responses were captured from a live run against the H2 dev profile.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "auth_url",
      "value": "http://localhost:8084"
    },
    {
      "key": "drugs_url",
      "value": "http://localhost:8081"
    },
    {
      "key": "sub_url",
      "value": "http://localhost:8082"
    },
    {
      "key": "refill_url",
      "value": "http://localhost:8083"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "memberId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign Up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{auth_url}}/api/auth/signup",
              "host": [
                "{{auth_url}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"bob\",\n  \"email\": \"bob@pharmacy.com\",\n  \"password\": \"password\",\n  \"fullName\": \"Bob Tester\"\n}"
            }
          },
          "response": [
            {
              "name": "201 Registered",
              "originalRequest": {
                "method": "POST",
                "url": {
                  "raw": "{{auth_url}}/api/auth/signup"
                }
              },
              "status": "OK",
              "code": 200,
              "body": "{\n  \"message\": \"User registered successfully!\"\n}"
            }
          ]
        },
        {
          "name": "Sign In",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('token', res.token);",
                  "pm.collectionVariables.set('memberId', res.memberId);",
                  "pm.test('token issued', () => pm.expect(res.token).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{auth_url}}/api/auth/signin",
              "host": [
                "{{auth_url}}"
              ],
              "path": [
                "api",
                "auth",
                "signin"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"member1\",\n  \"password\": \"password\"\n}"
            }
          },
          "response": [
            {
              "name": "200 JWT issued",
              "originalRequest": {
                "method": "POST",
                "url": {
                  "raw": "{{auth_url}}/api/auth/signin"
                }
              },
              "status": "OK",
              "code": 200,
              "body": "{\n  \"token\": \"eyJhbGciOiJIUzUxMiJ9...\",\n  \"username\": \"member1\",\n  \"memberId\": \"MEM001\",\n  \"expirationTime\": 900000,\n  \"type\": \"Bearer\"\n}"
            }
          ]
        },
        {
          "name": "Sign In (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('admin_token', res.token);",
                  "pm.test('admin token issued', () => pm.expect(res.role).to.eql('ADMIN'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{auth_url}}/api/auth/signin",
              "host": [
                "{{auth_url}}"
              ],
              "path": [
                "api",
                "auth",
                "signin"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password\"\n}"
            },
            "description": "Signs in as the seeded dev admin and stores the JWT in `admin_token`, used by the admin-only requests (List Users, Delete User, Update Refill Order Status)."
          },
          "response": []
        },
        {
          "name": "Validate Token",
          "request": {
            "method": "POST",
            "header": [
              {

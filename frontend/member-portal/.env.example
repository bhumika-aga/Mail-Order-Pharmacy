# Copy to .env.local for local overrides, or pass as build arguments / CI env vars.
# Vite bakes these into the bundle at build time, and the build's
# Content-Security-Policy allows API calls only to these origins.
# Unset values fall back to the local dev ports (localhost:8081-8084).
VITE_AUTH_SERVICE_URL=
VITE_DRUGS_SERVICE_URL=
VITE_SUBSCRIPTION_SERVICE_URL=
VITE_REFILL_SERVICE_URL=

# Show the demo accounts on the login page. Only for stacks that load the backend's
# development seed data (docker-compose); never set it for production.
VITE_SHOW_DEMO_CREDENTIALS=

# Build swagger-aggregator from the repository root:
#   docker build -f Dockerfile.swagger -t swagger-aggregator .

# ---- Build stage: compile with the official Maven image ----
FROM maven:3.9-eclipse-temurin-21 AS builder
WORKDIR /build

# Resolve dependencies first so they are cached between source changes
COPY backend/swagger-aggregator/pom.xml .
RUN mvn -B dependency:go-offline

COPY backend/swagger-aggregator/src src
RUN mvn -B clean package -DskipTests

# ---- Runtime stage: slim JRE, non-root user ----
FROM eclipse-temurin:21-jre-jammy
WORKDIR /app
RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser
COPY --from=builder --chown=appuser:appgroup /build/target/swagger-aggregator-*.jar app.jar
USER appuser

# Most hosting platforms inject PORT; fall back to the service's default port.
ENV PORT=8085
EXPOSE 8085
CMD ["sh", "-c", "exec java -Dserver.port=$PORT -jar /app/app.jar"]
